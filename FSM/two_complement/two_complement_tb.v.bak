`timescale 1ns/1ns

module two_complement_tb;

    reg in;
    reg clk;
    wire q;
    wire out;

    two_complement uut (
        .in(in),
        .clk(clk),
        .q(q),
        .out(out)
    );

    always #5 clk = ~clk;

    initial begin

        clk = 0;
        in  = 0;
        q   = 0;

        $display("Time\tCLK\tIN\tQ\tOUT");
        $display("-----------------------------");

        // Bit 1
        #7 in = 1;
        #3;
        $display("%0t\t%b\t%b\t%b\t%b",
                 $time, clk, in, q, out);

        // Bit 2
        #7 in = 0;
        #3;
        $display("%0t\t%b\t%b\t%b\t%b",
                 $time, clk, in, q, out);

        // Bit 3
        #7 in = 1;
        #3;
        $display("%0t\t%b\t%b\t%b\t%b",
                 $time, clk, in, q, out);

        // Bit 4
        #7 in = 1;
        #3;
        $display("%0t\t%b\t%b\t%b\t%b",
                 $time, clk, in, q, out);

        // Bit 5
        #7 in = 0;
        #3;
        $display("%0t\t%b\t%b\t%b\t%b",
                 $time, clk, in, q, out);

        // Bit 6
        #7 in = 0;
        #3;
        $display("%0t\t%b\t%b\t%b\t%b",
                 $time, clk, in, q, out);

        // Bit 7
        #7 in = 1;
        #3;
        $display("%0t\t%b\t%b\t%b\t%b",
                 $time, clk, in, q, out);

        // Bit 8
        #7 in = 0;
        #3;
        $display("%0t\t%b\t%b\t%b\t%b",
                 $time, clk, in, q, out);

        #5 $stop;

    end

endmodule
